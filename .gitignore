# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
!**/src/main/**/build/
!**/src/test/**/build/

*.dsk
*.DSK
# ...except the utility disks this project publishes
!src/apple/disks/*.dsk

# Apple II utility build outputs (the programs the tests run are copied to src/test/resources)
src/apple/*.o
src/apple/*.map
src/apple/*.bin

# Gradle wrapper local config (keep the wrapper jar/properties, ignore local overrides)
gradle.properties.local

# Java
*.class
*.jar
hs_err_pid*
replay_pid*

# IDE - IntelliJ
.idea/
*.iml
*.ipr
*.iws
out/

# IDE - Eclipse
.classpath
.project
.settings/
bin/

# IDE - VS Code
.vscode/

# macOS
.DS_Store

# Windows
Thumbs.db

# Logs
*.log
